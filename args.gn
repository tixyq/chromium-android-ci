target_os = "android"
target_cpu = "arm"
arm_version = 7
arm_float_abi = "softfp"

is_debug = false
# Official build + ThinLTO does not fit in a free 4-core / 6h runner.
# Turning both off yields a working release APK that builds in one job.
is_official_build = false
is_component_build = false
use_thin_lto = false
use_lld = true
symbol_level = 0
optimize_for_size = true

chrome_public_manifest_package = "com.android.chromium"

enable_nacl = false
enable_media_router = false
# Safe Browsing stays on: disabling it breaks the JNI registration check.
safe_browsing_mode = 1

target_android_sdk_version = 27
android_min_sdk_version = 27

enable_nacl = false
enable_remoting = false
enable_media_router = false
enable_vr = false
enable_cardboard = false
enable_arcore = false
enable_gvr_services = false
safe_browsing_mode = 0

target_android_sdk_version = 27
android_min_sdk_version = 27